    "test:e2e": "playwright test",
    "highlights": "tsx src/cli/highlights.ts",
    "stats": "tsx src/cli/stats.ts",
    "card": "tsx src/cli/card.ts",
    "episodes": "tsx src/cli/episodes.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
