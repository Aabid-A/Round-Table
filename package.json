{
  "name": "round-table",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An AI social-deduction show: 8 LLMs play a Traitors-style game.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
